MDC_PORT=3000
MDC_ENV=development

# Browser認証は全環境で必須。外部公開時はHTTPSとMDC_AUTH_COOKIE_SECURE=trueを使う。
# local: 管理者が作成したLocal Userのみ（self-signupなし）
# oidc:  SSOのみ、hybrid: SSO + Local User
MDC_AUTH_MODE=local
MDC_AUTH_COOKIE_SECURE=false
# compose.mdx.yamlのTLS edgeで使うbrowser向けhostname。
MDC_HOSTNAME=mado.example.com
# Pipeline用OpenLineage APIだけを公開する別hostname。
MDC_API_HOSTNAME=mado-api.example.com
# 操作していない間も含めて、ログインを7日間保つ（秒）。
MDC_AUTH_SESSION_IDLE_SECONDS=604800
MDC_AUTH_SESSION_ABSOLUTE_SECONDS=604800

# MDC_AUTH_MODE=oidc/hybridで必須。Authentik等のOIDC issuerを指定する。
MDC_OIDC_ISSUER_URL=
MDC_OIDC_CLIENT_ID=
MDC_OIDC_CLIENT_SECRET=
MDC_OIDC_REDIRECT_URI=
MDC_OIDC_LABEL=SSO
MDC_OIDC_SCOPES=openid email profile offline_access
# SSOの長時間利用には、Provider側のoffline_access scope mappingも有効にする。
# 未指定時はMDC_OIDC_REDIRECT_URIと同じoriginの / 。Authentik側にも登録する。
MDC_OIDC_POST_LOGOUT_REDIRECT_URI=
# email_verified=trueのときだけ同じemailのLocal UserへSSO identityを連携する。
MDC_OIDC_AUTO_LINK_VERIFIED_EMAIL=false
# OIDC利用時は必須。いずれかのgroup所属を必須にする。
MDC_OIDC_ALLOWED_GROUPS=mado-users,mado-admins,mado-curators,mado-operators
# Authentik group名 → このアプリのrole。設定するとログインごとにroleを同期する。
MDC_OIDC_ROLE_MAPPING_JSON={"mado-admins":"admin","mado-curators":"curator","mado-operators":"operator","mado-users":"viewer"}
MDC_OIDC_DEFAULT_ROLE=viewer

# Dataset Registryが正本、Marquezは再構築可能なprojection。
# 同一hostのDockerからhost公開portへ接続する例。
MDC_DATASET_REGISTRY_URL=http://host.docker.internal:8088
MDC_DATASET_REGISTRY_TOKEN=
MDC_MARQUEZ_URL=http://host.docker.internal:5000
MDC_LINEAGE_PORT=3001
MDC_OPENLINEAGE_BODY_LIMIT_BYTES=2097152

# compose 内部 DNS で api コンテナ → postgres コンテナへ。host は `postgres` 固定。
MDC_DATABASE_URL_RW=postgres://dashboard_rw:CHANGEME@postgres:5432/dashboard
MDC_DATABASE_URL_RO=postgres://dashboard_ro:CHANGEME@postgres:5432/dashboard
# DB の管理者 (postgres) の接続。api-internal が起動時に未適用の移行を当てるのに使い、無いと起動しない。
# compose の api-internal は POSTGRES_PASSWORD から組み立てた値で上書きするので、この行は compose を使わずに
# api を起動するとき (api/ の npm run dev) のため。ホストで動かすなら上の 2 行と同じく host を localhost にする。
MDC_DATABASE_URL_MIGRATE=postgres://postgres:postgres@postgres:5432/dashboard

# compose が postgres コンテナへ渡す DB 認証情報 (compose.{dev,prod}.yaml が参照)。
#  - prod(compose.prod.yaml): 未設定だと起動失敗。必ず強いパスワードを設定する必要がある。
#  - dev (compose.dev.yaml) : 未設定なら既定 (postgres / CHANGEME) で動く。
#  - MDC_DASHBOARD_DB_PASSWORD は上の MDC_DATABASE_URL_RW / MDC_DATABASE_URL_RO のパスワードと必ず一致させる。
#  - POSTGRES_PASSWORD は、api-internal が起動時に移行を当てる接続 (MDC_DATABASE_URL_MIGRATE) にも compose が使う。URL に入れられる hex にする。
# ※ いずれも DB ボリュームの「初回作成時のみ」反映される。既存DBのパスワード変更は
#    psql の ALTER ROLE が必要 (env を変えるだけでは効かない)。生成例: openssl rand -hex 24
POSTGRES_PASSWORD=
MDC_DASHBOARD_DB_PASSWORD=
# OpenLineage公開process専用DB role。英数字hexを推奨: openssl rand -hex 24
MDC_LINEAGE_DB_PASSWORD=
# media-worker専用DB role。prodは生成値を設定し、devは未設定なら開発用既定値。
MDC_WORKER_DB_PASSWORD=

# テストは host 上で vitest を直接実行するため localhost を使う (compose は postgres を 127.0.0.1:5432 に publish 済み)。
# 未設定でも api/routes/*.test.ts のフォールバックで同じ default が使われる。
# パスワードは MDC_DASHBOARD_DB_PASSWORD と必ず一致させること。ロールはその値で作られるため、
# ずれていると DB 依存テストが 100 件以上 "password authentication failed" で落ちる。
# 失敗が認証エラーなら DB は正常で、ここがずれているだけ (ボリュームの作り直しは不要)。
MDC_TEST_DATABASE_URL=postgres://dashboard_rw:CHANGEME@localhost:5432/dashboard_test
# テスト用 DB の表は、api/ で DB の管理者の接続を渡して移行を当てて作る (api-internal の起動時の移行と同じ処理)。
#   MDC_DATABASE_URL_MIGRATE=postgres://postgres:postgres@localhost:5432/dashboard_test npm run db:migrate

# storage_connections の S3 認証情報を AES-256-GCM で暗号化するキー (32 byte hex, openssl rand -hex 32)
MDC_STORAGE_SECRET_KEY=

# 画面を開く Origin (CORS・CSRF の検査に使う)。カンマ区切りで複数指定可能 (スペース区切りは不可)。
# 例: MDC_WEB_ORIGIN=http://localhost:5173,http://mado.internal
MDC_WEB_ORIGIN=http://localhost:5173

MDC_PREVIEW_TEXT_LIMIT=65536
MDC_PREVIEW_TAR_ENTRY_LIMIT=200
MDC_PREVIEW_TARXZ_BYTE_LIMIT=268435456
