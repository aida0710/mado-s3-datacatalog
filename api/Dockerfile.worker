# api/Dockerfile.worker — media-worker用のcompiled release image。
FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS build-deps

WORKDIR /app

RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ bzip2 \
 && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
RUN npm ci

FROM build-deps AS development
USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg \
 && rm -rf /var/lib/apt/lists/*
COPY . .
RUN chown -R node:node /app
USER node
EXPOSE 3100
CMD ["npx", "tsx", "worker.ts"]

FROM build-deps AS build
COPY . .
RUN npm run build \
 && npm prune --omit=dev

FROM node:22-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392 AS release
ARG MADO_VERSION=dev
ARG VCS_REF=""
ARG BUILD_DATE=""
LABEL org.opencontainers.image.title="Mado Media Worker" \
      org.opencontainers.image.description="Mado ffmpeg media analysis worker" \
      org.opencontainers.image.source="https://github.com/aida0710/mado-s3-datacatalog" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.version="$MADO_VERSION" \
      org.opencontainers.image.revision="$VCS_REF" \
      org.opencontainers.image.created="$BUILD_DATE"
WORKDIR /app
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build --chown=node:node /app/package.json /app/package-lock.json ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist ./dist
USER node
EXPOSE 3100
CMD ["node", "dist/worker.js"]
